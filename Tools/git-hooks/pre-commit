#!/bin/sh
# Schnelle Release-Gates vor jedem Commit (gemessen ~48 s).
#
# Gate B Besitz (gehoert mir der Commit?), Gate 0 Engine-Pfade, alle
# Python-Suiten, und Gate 1 NUR, wenn wirklich C++ vorgemerkt ist. Gates 2
# und 3 brauchen den Unreal-Editor und laufen darum vor dem PUSH (siehe
# pre-push) - ein Hook, der vor jedem Commit eine Viertelstunde braucht, wird
# umgangen und prueft dann gar nichts mehr.
#
# Gate B ist die Antwort auf den 27.09.2026: vier Tage lang fremde Arbeit
# uncommitted im geteilten Arbeitsbaum, und `git commit` haette ALLES
# mitgenommen. Wer beansprucht wurde:
#   python Tools/vor_dem_commit.py --besitz-ansprechen <Muster>
# (WB_THREAD oder `git config wb.thread` benennt den Thread; ohne beides
# gilt der Branchname - und auf einem Wegwerf-Branch wie wt-gatetest
# identifiziert der niemanden.)
#
# Notausgang:  git commit --no-verify   oder   WB_KEINE_GATES=1
WURZEL=$(git rev-parse --show-toplevel)
exec python "$WURZEL/Tools/vor_dem_commit.py" --stufe schnell --gestaged
